# Copy to .env and fill in. All values are public (they end up in the browser bundle).

# URL of the API server (the /server app)
VITE_API_BASE_URL=http://localhost:5000

# Your live site URL, used for the sitemap, canonical links and social previews
VITE_SITE_URL=https://your-domain.com

# Address the Contact page opens in the visitor's email app (optional)
VITE_CONTACT_EMAIL=

# Privacy-friendly analytics (optional, off when blank)
#   umami       → free Hobby plan at https://cloud.umami.is (SITE_ID = website ID)
#   goatcounter → free at https://www.goatcounter.com (SITE_ID = your code, e.g. "atsscore")
#   plausible   → paid or self-hosted (SITE_ID = your domain)
VITE_ANALYTICS_PROVIDER=
VITE_ANALYTICS_SITE_ID=
# Only for self-hosted instances; defaults to the provider's hosted script
VITE_ANALYTICS_SCRIPT_URL=
